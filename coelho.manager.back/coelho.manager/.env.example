# ============================================================
# Coelho Manager Backend - Environment Configuration Template
# Renomeie este arquivo para .env ou configure as variáveis no seu ambiente.
# ============================================================

# Configurações do Netbox
NETBOX_URL={NETBOX_URL}
NETBOX_TOKEN={NETBOX_TOKEN}

# Configurações de E-mail / Remetente
MAIL_FROM={EMAIL_REMETENTE}
MAIL_REPORT_TEMPLATE=templates/mail-report-template.txt
MAIL_SENDER_TEMPLATE=templates/mail-sender-template.txt
MAIL_TO_DEFAULT_PATH=templates/isp-client-form/default-mails.txt

# Configurações do Servidor SMTP
SMTP_HOST={SMTP_HOST}
SMTP_PORT={SMTP_PORT}
SMTP_USER={SMTP_USER}
SMTP_PASSWORD={SMTP_PASSWORD}

# Configurações de Diretórios e OCR
IMAGES_REPOSITORY_PATH={CAMINHO_REPOSITORIO_IMAGENS}
TESSDATA_PATH={CAMINHO_TESSDATA_OCR}
LOG_PATH={CAMINHO_LOGS}
